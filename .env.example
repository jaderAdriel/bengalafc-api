# Django Settings
SECRET_KEY=django-insecure-your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,bengalafc-api-production.up.railway.app,bengalafc-api-production-0a3a.up.railway.app
CSRF_TRUSTED_ORIGINS=https://bengalafc-api-production-0a3a.up.railway.app,https://bengalafc-api-production.up.railway.app,http://localhost:8000,http://127.0.0.1:8000

# Database Settings (Railway PostgreSQL / SQLite fallback)
# If DATABASE_URL or DATABASE_PUBLIC_URL is provided, PostgreSQL is used. Otherwise, SQLite is used.
# DATABASE_URL=postgresql://postgres:password@host:port/database
# DATABASE_PUBLIC_URL=postgresql://postgres:password@host:port/database

# Integration with Football API (API-Football / API-Sports)
# Base URL: Use https://v3.football.api-sports.io (API-Sports) or RapidAPI endpoint
FOOTBALL_API_URL=https://v3.football.api-sports.io
# Your Secret API Key
FOOTBALL_API_KEY=5eb33b37effe9097804ffc507c1a2f2b
# Authentication Header: x-apisports-key (API-Sports direct) or x-rapidapi-key (RapidAPI)
FOOTBALL_API_HEADER=x-apisports-key

# Default tournament settings (used by sync jobs when no overrides are passed)
# 1 = World Cup (Copa do Mundo)
FOOTBALL_API_DEFAULT_COMPETITION_ID=1
FOOTBALL_API_DEFAULT_SEASON=2022